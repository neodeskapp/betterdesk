# Dockerfile for BetterDesk Server (Go)
# Multi-stage build: compile from source, then copy to minimal runtime image
#
# The BetterDesk server is a single binary that replaces both hbbs and hbbr.
# It provides: signal (UDP/TCP/WS), relay (TCP/WS), HTTP API, admin console.
#
# Build: docker build -f Dockerfile.server -t betterdesk-server:local .

# ---- Web app build (embedded in the binary, DECISIONS A25) ----
FROM node:22.23.2-alpine3.24 AS web-ui-builder

WORKDIR /web-ui

# npm 10 (bundled with Node 22) fails to resolve this dependency tree (web-ui-ci.yml)
COPY web-ui/package.json web-ui/package-lock.json ./
RUN npx -y npm@11.6.2 ci --no-audit --no-fund

COPY web-ui/ .
RUN npm run build

# ---- Build stage ----
FROM golang:1.26.11-alpine AS builder
ARG TARGETARCH

RUN apk add --no-cache git || { sleep 2 && apk add --no-cache git; }

WORKDIR /src

# Copy Go module files first (cache dependencies)
COPY betterdesk-server/go.mod betterdesk-server/go.sum ./

RUN go mod download

# Copy full source
COPY betterdesk-server/ .

# The binary carries the web app, as the release binaries do
COPY --from=web-ui-builder /web-ui/build /web-ui-build
RUN go run ./cmd/embed-webui -from /web-ui-build

# The binary's version, build date and commit (-version, the update check).
# Without build arguments: the version in VERSION and the time of the build;
# the commit only when BETTERDESK_COMMIT_SHA names it (the publish workflow
# and docker-compose.single.yml pass it).
ARG BETTERDESK_PRODUCT_VERSION=
ARG BETTERDESK_COMMIT_SHA=
ARG BETTERDESK_BUILD_DATE=

# Build static binary (modernc.org/sqlite is pure Go — no CGO needed)
RUN version="${BETTERDESK_PRODUCT_VERSION:-$(tr -d '[:space:]' < VERSION)}" && \
    built="${BETTERDESK_BUILD_DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X main.Version=${version} -X main.Commit=${BETTERDESK_COMMIT_SHA} -X main.BuildDate=${built}" \
    -tags "netgo osusergo" \
    -o /betterdesk-server .

# ---- Runtime stage ----
FROM alpine:3.22

LABEL maintainer="trybetterdesk"
LABEL description="BetterDesk Server - RustDesk-compatible signal + relay"
LABEL org.opencontainers.image.source="https://github.com/trybetterdesk/betterdesk"
LABEL version="3.5.270"

RUN apk add --no-cache \
    ca-certificates \
    curl \
    sqlite \
    tini \
    su-exec \
    shadow \
    || { sleep 2 && apk add --no-cache \
    ca-certificates curl sqlite tini su-exec shadow; } \
    && addgroup -g 10001 -S betterdesk \
    && adduser -u 10001 -S -G betterdesk betterdesk

COPY --from=builder /betterdesk-server /usr/local/bin/betterdesk-server
RUN chmod +x /usr/local/bin/betterdesk-server

# Create data directory before writing build metadata into it
RUN mkdir -p /opt/rustdesk && chown betterdesk:betterdesk /opt/rustdesk

ARG BETTERDESK_COMMIT_SHA=unknown
ARG BETTERDESK_IMAGE_VERSION=unknown
ENV BETTERDESK_IMAGE_SHA=${BETTERDESK_COMMIT_SHA}
ENV BETTERDESK_IMAGE_VERSION=${BETTERDESK_IMAGE_VERSION}
RUN printf '%s\n' "${BETTERDESK_COMMIT_SHA}" > /opt/rustdesk/.image-commit

# Entrypoint script: fixes volume permissions, then drops to betterdesk user
COPY docker/ensure-app-user.sh /ensure-app-user.sh
COPY docker/server-entrypoint.sh /server-entrypoint.sh
COPY docker/bootstrap-admin-credentials.sh /docker/bootstrap-admin-credentials.sh
COPY docker/show-admin-credentials.sh /usr/local/bin/betterdesk-show-admin-credentials
COPY docker/healthcheck.sh /usr/local/bin/betterdesk-healthcheck
RUN chmod +x /ensure-app-user.sh /server-entrypoint.sh /docker/bootstrap-admin-credentials.sh /usr/local/bin/betterdesk-show-admin-credentials /usr/local/bin/betterdesk-healthcheck

WORKDIR /opt/rustdesk

# Server only: the console in this binary is on by default (DECISIONS A27)
# and stays off in this image; the betterdesk image runs both in one process
ENV CONSOLE_PORT=0

# Ports:
# 21121 - HTTP API (RustDesk client API + REST)
# 21122 - CDAP gateway (custom devices and agents)
# 21115 - NAT type test
# 21116 - Signal (TCP+UDP)
# 21117 - Relay (TCP)
# 21118 - WebSocket Signal
# 21119 - WebSocket Relay
EXPOSE 21115 21116/tcp 21116/udp 21117 21118 21119 21121 21122

# Health check via the API (the console is off here), over HTTPS with TLS_API
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD /usr/local/bin/betterdesk-healthcheck

# Note: Container starts as root so entrypoint can fix volume permissions.
# server-entrypoint.sh drops to betterdesk user via su-exec before running the server.

ENTRYPOINT ["/sbin/tini", "--", "/server-entrypoint.sh"]
CMD ["/usr/local/bin/betterdesk-server", "-mode", "all", "-api-port", "21121", "-key-file", "/opt/rustdesk/id_ed25519"]
