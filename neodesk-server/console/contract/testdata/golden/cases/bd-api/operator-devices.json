{
 "id": "bd-api/operator-devices",
 "request": {
  "method": "GET",
  "path": "/api/nd/operator/devices",
  "notes": [
   "header Authorization: Bearer {secret:operator_token}",
   "no CSRF token",
   "no cookies"
  ]
 },
