{
 "id": "ws-nd-relay/target-joins",
 "request": {
  "method": "GET",
  "path": "/ws/nd-relay?role=target&session=%7Brelay%7D&token=%7Bsecret%3Atarget_token%7D",
  "notes": [
   "websocket tgt, own origin",
   "websocket expect 1 messages"
  ]
 },
 "recordings": 2,
 "answers": [
  {
   "roles": [
    "signed-out"
   ],
   "status": 101,
   "volatile": [
    {
     "path": "messages[*].json.session",
     "pattern": "^[9aA+/_=-]{36}$"
    }
   ],
   "body": {
    "kind": "json",
    "json": {
     "messages": [
      {
       "json": {
        "session": "<volatile>",
        "type": "paired"
       },
       "order": "type session"
      }
     ]
    }
   }
  }
 ]
}
