{
 "id": "onboard/public-invite",
 "request": {
  "method": "GET",
  "path": "/api/onboard/public/{secret:invite_code}",
  "notes": [
   "no CSRF token",
   "no cookies"
  ]
 },
 "recordings": 2,
 "answers": [
  {
   "roles": [
    "admin"
   ],
   "status": 200,
   "headers": {
    "cache-control": "no-cache, no-store, must-revalidate",
    "content-security-policy": "default-src 'self';script-src 'self';script-src-attr 'none';style-src 'self' 'unsafe-inline';font-src 'self';img-src 'self' data: blob:;media-src 'self' blob:;connect-src 'self' ws:;frame-src 'none';object-src 'none';worker-src 'self' blob:;base-uri 'self';form-action 'self';frame-ancestors 'none'",
    "content-type": "application/json; charset=utf-8",
    "cross-origin-resource-policy": "same-origin",
    "etag": "<present>",
    "permissions-policy": "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()",
    "ratelimit-limit": "20",
    "ratelimit-policy": "20;w=60",
    "ratelimit-remaining": "<n>",
    "ratelimit-reset": "<n>",
    "referrer-policy": "strict-origin-when-cross-origin",
    "set-cookie": "__csrf_h=<value>; Path=/; HttpOnly; SameSite=Lax",
    "x-content-type-options": "nosniff",
    "x-dns-prefetch-control": "off",
    "x-download-options": "noopen",
    "x-frame-options": "DENY",
    "x-permitted-cross-domain-policies": "none",
    "x-xss-protection": "0"
   },
   "volatile": [
    {
     "path": "display_code",
     "pattern": "^[9aA+/_=-]{9}$"
    },
    {
     "path": "expires_at",
     "format": "9999-99-99A99:99:99A"
    }
   ],
   "body": {
    "kind": "json",
    "json": {
     "code": "{secret:invite_code}",
     "company": "NeoDesk",
     "deep_link": "neodesk://join/<host>/{secret:invite_code}?http=1",
     "display_code": "<volatile>",
     "downloads": [],
     "expires_at": "<volatile>",
     "install_command": "curl -fsSL '<base>/join/{secret:invite_code}/install.sh' | sudo sh",
     "kind": "join",
     "publisher": "Rath & Blume GbR",
     "release_error": "release_unavailable",
     "server": {
      "address": "<base>",
      "host": "<hostname>",
      "https": false,
      "name": "NeoDesk"
     },
     "success": true,
     "supporter": "e2e_admin"
    }
   }
  }
 ]
}
