{
 "id": "chat/upload-empty-file",
 "request": {
  "method": "POST",
  "path": "/api/chat/upload",
  "notes": [
   "multipart form: note, file (file empty.bin, 0 bytes)"
  ]
 },
 "recordings": 2,
 "answers": [
  {
   "roles": [
    "admin"
   ],
   "status": 200,
   "headers": {
    "cache-control": "no-cache, no-store, must-revalidate",
    "content-security-policy": "default-src 'self';script-src 'self';script-src-attr 'none';style-src 'self' 'unsafe-inline';font-src 'self';img-src 'self' data: blob:;media-src 'self' blob:;connect-src 'self' ws:;frame-src 'none';object-src 'none';worker-src 'self' blob:;base-uri 'self';form-action 'self';frame-ancestors 'none'",
    "content-type": "application/json; charset=utf-8",
    "cross-origin-resource-policy": "same-origin",
    "etag": "<present>",
    "permissions-policy": "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()",
    "ratelimit-limit": "1000000",
    "ratelimit-policy": "1000000;w=60",
    "ratelimit-remaining": "<n>",
    "ratelimit-reset": "<n>",
    "referrer-policy": "strict-origin-when-cross-origin",
    "set-cookie": "nd.sid=<value>; Path=/; Expires=<date>; HttpOnly; SameSite=Lax",
    "x-content-type-options": "nosniff",
    "x-dns-prefetch-control": "off",
    "x-download-options": "noopen",
    "x-frame-options": "DENY",
    "x-permitted-cross-domain-policies": "none",
    "x-xss-protection": "0"
   },
   "volatile": [
    {
     "path": "file_id",
     "pattern": "^[9aA+/_=-]{32}$"
    },
    {
     "path": "filename",
     "pattern": "^[9aA+/_=-]{32}\\.[9aA+/_=-]{3}$"
    },
    {
     "path": "url",
     "pattern": "^[9aA+/_=-]{48}$"
    }
   ],
   "body": {
    "kind": "json",
    "json": {
     "file_id": "<volatile>",
     "filename": "<volatile>",
     "size": 0,
     "success": true,
     "url": "<volatile>"
    }
   }
  }
 ]
}
