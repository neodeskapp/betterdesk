# =============================================================
# .dockerignore — Reduce Docker build context and prevent
# local development artifacts from leaking into images.
# =============================================================

# Node.js — CRITICAL: local node_modules contain platform-specific
# native binaries (e.g. Windows x64) that will break Linux/Alpine
# containers.  The Dockerfile builds its own node_modules.
**/node_modules/

# The Node.js console's folder of an install from before the web console
# moved into the server binary: no image reads it, and its .env and data
# stay out of the build
web-nodejs/

# Git
.git/
.gitignore
.github/

# Go build artifacts (binary is built inside Docker)
neodesk-server/neodesk-server
neodesk-server/neodesk-server-*
neodesk-server/*.exe
neodesk-server/db_v2.sqlite3
neodesk-server/id_ed25519
neodesk-server/id_ed25519.pub
neodesk-server/test_*.go
neodesk-server/_test_*

# The installers and compose files (install/): no image needs them
install/

# Archive (old/deprecated files)
archive/



# Documentation (not needed in image)
docs/
screenshots/
*.md
!docker/*.md

# Development & testing
dev_modules/
TESTING.local.md
neodesk-client/
neodesk-desktop/
neodesk-agent-client/
neodesk-agent/
rdclient-desktop/
neodesk-mgmt/

# Sensitive files
*.key
*.pem
*.pub
.env
.env.*
*credentials*
*secret*.key

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Databases (created at runtime)
*.sqlite3
*.db

# Logs
*.log
logs/

# Backups
*.backup
*.bak
rustdesk-backup-*/

# Web UI: the image builds its own; e2e/.auth holds signed-in test sessions
web-ui/build/
web-ui/.svelte-kit/
web-ui/test-results/
web-ui/playwright-report/
web-ui/e2e/.auth/
