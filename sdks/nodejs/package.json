{
  "name": "betterdesk-cdap",
  "version": "1.0.0",
  "description": "Node.js SDK for BetterDesk CDAP (Connected Device Automation Protocol)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "default": "./dist/widgets.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/sdk.test.mts"
  },
  "keywords": ["betterdesk", "cdap", "iot", "scada", "bridge", "remote-management"],
  "license": "AGPL-3.0",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
