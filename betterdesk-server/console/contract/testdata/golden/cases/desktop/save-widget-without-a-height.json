{
 "id": "desktop/save-widget-without-a-height",
 "request": {
  "method": "POST",
  "path": "/api/desktop/layout",
  "body": {
   "widgets": [
    {
     "id": "w",
     "type": "clock",
     "w": 1,
     "x": 0,
     "y": 0
    }
   ]
  }
 },
 "recordings": 2,
