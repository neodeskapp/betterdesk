{
 "id": "cdap-toggle/toggle-by-admin",
 "request": {
  "method": "POST",
  "path": "/api/cdap/toggle",
  "body": {
   "enabled": true
  },
  "notes": [
   "sent as admin in every role's turn"
  ]
 },
 "recordings": 2,
 "answers": [
  {
   "roles": [
    "signed-out",
    "pro",
    "guest_issuer",
    "viewer",
    "operator",
    "global_admin",
    "admin"
   ],
   "status": 200,
   "headers": {
    "cache-control": "no-cache, no-store, must-revalidate",
    "content-security-policy": "default-src 'self';script-src 'self';script-src-attr 'none';style-src 'self' 'unsafe-inline';font-src 'self';img-src 'self' data: blob:;media-src 'self' blob:;connect-src 'self' ws:;frame-src 'none';object-src 'none';worker-src 'self' blob:;base-uri 'self';form-action 'self';frame-ancestors 'none'",
    "content-type": "application/json; charset=utf-8",
    "cross-origin-resource-policy": "same-origin",
    "etag": "<present>",
    "permissions-policy": "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()",
    "ratelimit-limit": "1000000",
    "ratelimit-policy": "1000000;w=60",
    "ratelimit-remaining": "<n>",
    "ratelimit-reset": "<n>",
    "referrer-policy": "strict-origin-when-cross-origin",
    "set-cookie": "bd.sid=<value>; Path=/; Expires=<date>; HttpOnly; SameSite=Lax",
    "x-content-type-options": "nosniff",
    "x-dns-prefetch-control": "off",
    "x-download-options": "noopen",
    "x-frame-options": "DENY",
    "x-permitted-cross-domain-policies": "none",
    "x-xss-protection": "0"
   },
   "volatile": [
    {
     "path": "restartRequired.id",
     "pattern": "^[9aA+/_=-]{36}$"
    },
    {
     "path": "restartRequired.updatedAt",
     "format": "9999-99-99A99:99:99.999A"
    }
   ],
   "body": {
    "kind": "json",
    "json": {
     "enabled": true,
     "restartRequired": {
      "changes": [
       {
        "key": "cdap-enabled",
        "label": "CDAP Devices"
       }
      ],
      "error": null,
      "failed": false,
      "id": "<volatile>",
      "phase": "pending",
      "ready": false,
      "startedAt": null,
      "status": "pending",
      "updatedAt": "<volatile>"
     },
     "restart_required": true,
     "success": true
    }
   }
  },
  {
   "roles": [
    "server_admin",
    "super_admin"
   ],
   "status": 500,
   "headers": {
    "cache-control": "no-cache, no-store, must-revalidate",
    "content-security-policy": "default-src 'self';script-src 'self';script-src-attr 'none';style-src 'self' 'unsafe-inline';font-src 'self';img-src 'self' data: blob:;media-src 'self' blob:;connect-src 'self' ws:;frame-src 'none';object-src 'none';worker-src 'self' blob:;base-uri 'self';form-action 'self';frame-ancestors 'none'",
    "content-type": "application/json; charset=utf-8",
    "cross-origin-resource-policy": "same-origin",
    "etag": "<present>",
    "permissions-policy": "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()",
    "ratelimit-limit": "1000000",
    "ratelimit-policy": "1000000;w=60",
    "ratelimit-remaining": "<n>",
    "ratelimit-reset": "<n>",
    "referrer-policy": "strict-origin-when-cross-origin",
    "set-cookie": "bd.sid=<value>; Path=/; Expires=<date>; HttpOnly; SameSite=Lax",
    "x-content-type-options": "nosniff",
    "x-dns-prefetch-control": "off",
    "x-download-options": "noopen",
    "x-frame-options": "DENY",
    "x-permitted-cross-domain-policies": "none",
    "x-xss-protection": "0"
   },
   "body": {
    "kind": "json",
    "json": {
     "error": "Failed to toggle CDAP",
     "success": false
    }
   }
  }
 ]
}
