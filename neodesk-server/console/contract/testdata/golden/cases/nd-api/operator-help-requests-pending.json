       "device_id": "900100017",
       "hostname": "demo-sales-laptop-01",
       "id": "2",
       "message": "VPN keeps dropping since the update",
       "resolved_by": "",
       "status": "pending"
      }
     ],
     "success": true
    }
   }
  }
 ]
}
