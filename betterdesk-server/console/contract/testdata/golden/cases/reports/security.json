        "logged": null,
        "total": 0,
        "usb_events": null
       }
      },
      "recent_audit": []
     },
     "filters": {},
     "generated_at": "<volatile>",
     "label": "Security Report",
     "type": "security"
    }
   }
  }
 ]
}
