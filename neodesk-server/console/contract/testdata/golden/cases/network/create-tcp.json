{
 "id": "network/create-tcp",
 "request": {
  "method": "POST",
  "path": "/api/network/targets",
  "body": {
   "check_type": "tcp",
   "host": "{console_host}",
   "interval_ms": 30000,
   "name": "Contract tcp",
   "port": 5000,
   "timeout_ms": 3000
  }
 },
 "recordings": 2,
 "answers": [
  {
   "roles": [
    "signed-out",
    "pro"
   ],
   "status": 401,
   "headers": {
    "cache-control": "no-cache, no-store, must-revalidate",
    "content-security-policy": "default-src 'self';script-src 'self';script-src-attr 'none';style-src 'self' 'unsafe-inline';font-src 'self';img-src 'self' data: blob:;media-src 'self' blob:;connect-src 'self' ws:;frame-src 'none';object-src 'none';worker-src 'self' blob:;base-uri 'self';form-action 'self';frame-ancestors 'none'",
    "content-type": "application/json; charset=utf-8",
    "cross-origin-resource-policy": "same-origin",
    "etag": "<present>",
    "permissions-policy": "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()",
    "ratelimit-limit": "1000000",
    "ratelimit-policy": "1000000;w=60",
    "ratelimit-remaining": "<n>",
    "ratelimit-reset": "<n>",
    "referrer-policy": "strict-origin-when-cross-origin",
    "x-content-type-options": "nosniff",
    "x-dns-prefetch-control": "off",
    "x-download-options": "noopen",
    "x-frame-options": "DENY",
    "x-permitted-cross-domain-policies": "none",
    "x-xss-protection": "0"
   },
   "volatile": [
    "id",
    "last_rtt_ms"
   ],
   "body": {
    "kind": "json",
    "json": {
     "error": "Authentication required"
    }
   }
  },
  {
   "roles": [
    "guest_issuer",
    "viewer",
    "operator",
    "global_admin"
   ],
   "status": 403,
   "headers": {
    "cache-control": "no-store",
    "content-security-policy": "default-src 'self';script-src 'self';script-src-attr 'none';style-src 'self' 'unsafe-inline';font-src 'self';img-src 'self' data: blob:;media-src 'self' blob:;connect-src 'self' ws:;frame-src 'none';object-src 'none';worker-src 'self' blob:;base-uri 'self';form-action 'self';frame-ancestors 'none'",
    "content-type": "application/json; charset=utf-8",
    "cross-origin-resource-policy": "same-origin",
    "etag": "<present>",
    "permissions-policy": "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()",
    "referrer-policy": "strict-origin-when-cross-origin",
    "set-cookie": "bd.sid=<value>; Path=/; Expires=<date>; HttpOnly; SameSite=Lax",
    "x-content-type-options": "nosniff",
    "x-dns-prefetch-control": "off",
    "x-download-options": "noopen",
    "x-frame-options": "DENY",
    "x-permitted-cross-domain-policies": "none",
    "x-xss-protection": "0"
   },
   "volatile": [
    "id",
    "last_rtt_ms"
   ],
   "body": {
    "kind": "json",
    "json": {
     "code": "panel_access_denied",
     "error": "Panel access denied: network",
     "success": false
    }
   }
  },
  {
   "roles": [
    "server_admin",
    "super_admin",
    "admin"
   ],
   "status": 201,
   "headers": {
    "cache-control": "no-cache, no-store, must-revalidate",
    "content-security-policy": "default-src 'self';script-src 'self';script-src-attr 'none';style-src 'self' 'unsafe-inline';font-src 'self';img-src 'self' data: blob:;media-src 'self' blob:;connect-src 'self' ws:;frame-src 'none';object-src 'none';worker-src 'self' blob:;base-uri 'self';form-action 'self';frame-ancestors 'none'",
    "content-type": "application/json; charset=utf-8",
    "cross-origin-resource-policy": "same-origin",
    "etag": "<present>",
    "permissions-policy": "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()",
    "ratelimit-limit": "1000000",
    "ratelimit-policy": "1000000;w=60",
    "ratelimit-remaining": "<n>",
    "ratelimit-reset": "<n>",
    "referrer-policy": "strict-origin-when-cross-origin",
    "set-cookie": "bd.sid=<value>; Path=/; Expires=<date>; HttpOnly; SameSite=Lax",
    "x-content-type-options": "nosniff",
    "x-dns-prefetch-control": "off",
    "x-download-options": "noopen",
    "x-frame-options": "DENY",
    "x-permitted-cross-domain-policies": "none",
    "x-xss-protection": "0"
   },
   "volatile": [
    {
     "path": "created_at",
     "format": "9999-99-99 99:99:99"
    },
    {
     "path": "id",
     "integer": true
    },
    "last_rtt_ms",
    {
     "path": "updated_at",
     "format": "9999-99-99 99:99:99"
    }
   ],
   "body": {
    "kind": "json",
    "json": {
     "check_type": "tcp",
     "created_at": "<volatile>",
     "enabled": 1,
     "host": "<hostname>",
     "id": 0,
     "interval_ms": 30000,
     "last_check_at": null,
     "last_rtt_ms": null,
     "last_status": null,
     "name": "Contract tcp",
     "port": 5000,
     "timeout_ms": 3000,
     "updated_at": "<volatile>",
     "url": null
    }
   }
  }
 ]
}
